704. Binary Search
class Solution {
    public int search(int[] nums, int target) {
        int n = nums.length;
        int s = 0;
        int e = n-1;
        int ans = -1;
        while(s <= e){
            int mid = s + (e-s)/2;
            if(target == nums[mid]){
                ans = mid;
                return ans;
            }
            else if(target < nums[mid]){
                e = mid-1;
            }
            else{
                s = mid+1;
            }
        }
        return ans;
    }
}



35. Search Insert Position
class Solution {
    public int searchInsert(int[] nums, int target) {
        int start = 0;
        int end = nums.length-1;

        while (start <= end) {
            int mid = start + (end-start)/2;
            if (nums[mid] == target) return mid;
            else if (nums[mid] > target) end = mid-1;
            else start = mid+1;
        }

        return start;
    }
}




93. Restore IP Addresses
class Solution {
    List<String> result=new ArrayList<>();
    public List<String> restoreIpAddresses(String s) {
        if(s.length()<4||s.length()>12) return result;
        helper(s,0,0,new StringBuilder ());
        return result;
    }
    public void helper(String s,int startIdx,int count,StringBuilder sb){
        if(count==4){
            if(startIdx==s.length()){
                result.add(sb.toString());
                
            }
            return;
        }
        for(int len=1;len<=3;len++){
            if(startIdx+len>s.length()) break;
            String str=s.substring(startIdx,startIdx+len);
            if(isValid(str)){
                int prevlength=sb.length();
                sb.append(str);
                if(count<3) sb.append(".");
                helper(s,startIdx+len,count+1,sb);
                sb.setLength(prevlength);
            }
        }
    }
    public boolean isValid(String str){
        if(str.charAt(0)=='0'&&str.length()>1) return false;
        int value=Integer.parseInt(str);
        return value>=0&&value<=255;
    }
}



74. Search a 2D Matrix
class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int leftRow = 0;
        int rightRow = matrix.length - 1;
        int lastNum = matrix[0].length - 1;

        while( leftRow <= rightRow )
        {
            int mid = leftRow + (rightRow - leftRow) / 2;

            if( matrix[mid][0] == target )
                return true;
            else if(matrix[mid][0] > target)
                rightRow = mid - 1;
            else if( matrix[mid][lastNum] < target)
                leftRow = mid + 1;
            else
            {
                int leftCol = 0;
                int rightCol = lastNum;

                while(leftCol <= rightCol)
                {
                    int midCol = leftCol + (rightCol - leftCol) / 2;

                    if(matrix[mid][midCol] == target)
                        return true;
                    else if(matrix[mid][midCol] < target)
                        leftCol = midCol + 1;
                    else
                        rightCol = midCol - 1;
                }
                return false;
            }
        }
        return false; 
    }
}




162. Find Peak Element
class Solution {
    public int findPeakElement(int[] nums) {

        int l=0;
        int r=nums.length-1;

        while(l<r){
            int mid=l+(r-l)/2;

            if(nums[mid]<nums[mid+1]){
                l=mid+1;
            }

            else r=mid;

        }
        return l;
    }
}





